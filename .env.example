# Stripe TEST only. Live keys are rejected by /api/checkout.
# Required to start a $0.99 TEST Checkout session:
STRIPE_SECRET_KEY=sk_test_replace_me

# Optional aliases (first present TEST key wins):
# STRIPE_TEST_SECRET_KEY=
# STRIPE_RESTRICTED_KEY=rk_test_replace_me

# Optional public test key for Dashboard / client display. Never put sk_ in the browser.
# STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
