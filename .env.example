# Stripe LIVE Checkout (Joseph GO 2026-09-19). Test keys are rejected.
STRIPE_MODE=live
STRIPE_SECRET_KEY=sk_live_replace_me

# Optional aliases (first present LIVE key wins):
# STRIPE_LIVE_SECRET_KEY=
# STRIPE_RESTRICTED_KEY=rk_live_replace_me

# Optional public live key for Dashboard / client display. Never put sk_ in the browser.
# STRIPE_PUBLISHABLE_KEY=pk_live_replace_me

# --- Automatic digital delivery (/api/stripe/webhook, /api/download, /buy/success) ---
# Signing secret of the Stripe endpoint https://agentic.lvlltd.com/api/stripe/webhook.
# Missing => webhook fails closed with 503.
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# >= 32 random chars (e.g. openssl rand -hex 32). Signs short-lived download links.
DELIVERY_SIGNING_SECRET=replace_me
# Optional link lifetime in hours (default 72, max 168).
# DELIVERY_LINK_TTL_HOURS=72
# Read-only GitHub token (fine-grained, Contents: read) for the PRIVATE repo
# omgawdmadeit1/lvlltd-agent-marketplace. Pack files are fetched at pinned commit
# 40a49f1 and served only if their sha256 matches /api/packs.
DELIVERY_GITHUB_TOKEN=replace_me
# Optional origin used in emailed/success links (default https://agentic.lvlltd.com).
# DELIVERY_PUBLIC_ORIGIN=https://agentic.lvlltd.com
# Optional delivery email via Resend (link only, never attachments). No-op when unset.
# RESEND_API_KEY=re_replace_me
# DELIVERY_FROM_EMAIL="LVL <orders@your-verified-domain>"
